{
  "expo": {
    "name": "StokMaster",
    "slug": "stokmaster",
    "version": "2.1.1",
    "orientation": "portrait",
    "scheme": "stokmaster",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#001B3F"
    },
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#001B3F"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que StokMaster use la cámara para escanear códigos de barras",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07d05360-8c34-4bb7-8598-a3342df36b3f"
      }
    }
  }
}
